# Copy to .env and adjust. Every variable below has a safe development default,
# so the application also runs with no .env file at all.

# Never leave this at the default outside local development.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=Europe/Amsterdam

# Path to the SQLite database file, relative to the project root.
DJANGO_SQLITE_PATH=db.sqlite3

# Only read when DJANGO_DEBUG is false. Leave it enabled in a real deployment; set it to
# false to run a non-debug server locally over plain HTTP.
DJANGO_SECURE_SSL_REDIRECT=true
